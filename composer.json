{
    "name": "deokon/plume",
    "version": "0.8.0",
    "description": "A comprehensive UI library for Laravel and Alpine.js",
  "license": "MIT",
  "authors": [
    {
      "name": "Dennis Okon",
      "email": "deokon@gmail.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "illuminate/support": "^10.0|^11.0|^12.0",
    "illuminate/view": "^10.0|^11.0|^12.0"
  },
  "autoload": {
    "psr-4": {
      "deokon\\Plume\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "deokon\\Plume\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "deokon\\Plume\\PlumeServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "vendor/bin/pest",
    "test:coverage": "vendor/bin/pest --coverage"
  },
  "require-dev": {
    "pestphp/pest": "^4.3",
    "pestphp/pest-plugin-laravel": "^4.0",
    "orchestra/testbench": "^10.9"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
